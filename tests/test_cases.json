{
  "基本文本操作测试": {
    "steps": [
      {
        "action": "set_content",
        "text": "Hello, World!"
      },
      {
        "action": "move_cursor",
        "position": "1.0"
      },
      {
        "action": "comment",
        "text": "测试选择文本功能"
      },
      {
        "action": "select_text",
        "start": "1.0",
        "end": "1.5"
      },
      {
        "action": "assert_selection",
        "expected": "Hello"
      },
      {
        "action": "comment",
        "text": "测试方向键行为 (VSCode 风格)"
      },
      {
        "action": "on_key_press",
        "keysym": "Left",
        "modifiers": []
      },
      {
        "action": "assert_selection",
        "expected": "Hello"
      },
      {
        "action": "on_key_press",
        "keysym": "Left",
        "modifiers": []
      },
      {
        "action": "assert_selection",
        "expected": ""
      }
    ]
  },
  "多光标编辑核心功能测试": {
    "steps": [
      {
        "action": "set_content",
        "text": "test test test test test"
      },
      {
        "action": "select_text",
        "start": "1.0",
        "end": "1.4"
      },
      {
        "action": "comment",
        "text": "测试多光标选择"
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 3
      },
      {
        "action": "comment",
        "text": "测试多光标输入"
      },
      {
        "action": "on_key_press",
        "keysym": "a",
        "char": "a",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "a a a test test"
      },
      {
        "action": "comment",
        "text": "测试多光标粘贴"
      },
      {
        "action": "set_clipboard",
        "content": "replaced"
      },
      {
        "action": "on_paste",
        "keysym": "v",
        "modifiers": ["Command"],
        "content": "replaced"
      },
      {
        "action": "assert_content",
        "expected": "replaced replaced replaced test test"
      },
      {
        "action": "comment",
        "text": "测试多光标回车键"
      },
      {
        "action": "on_key_press",
        "keysym": "Return",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "\n \n \n test test"
      },
      {
        "action": "comment",
        "text": "测试多光标退出"
      },
      {
        "action": "on_key_press",
        "keysym": "Escape",
        "modifiers": []
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 0
      }
    ]
  },
  "快捷键功能测试": {
    "steps": [
      {
        "action": "comment",
        "text": "测试 Command+Up/Down 移动到文档头部/尾部"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3\nLine 4\nLine 5"
      },
      {
        "action": "move_cursor",
        "position": "3.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Up",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_cursor_position",
        "expected": "1.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Down",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_cursor_position",
        "expected": "5.6"
      },
      {
        "action": "comment",
        "text": "测试 Command+Shift+Up/Down 选择到文档头部/尾部"
      },
      {
        "action": "move_cursor",
        "position": "3.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Up",
        "modifiers": ["Command", "Shift"]
      },
      {
        "action": "assert_selection",
        "expected": "Line 1\nLine 2\nLine 3"
      },
      {
        "action": "clear_selection"
      },
      {
        "action": "move_cursor",
        "position": "3.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Down",
        "modifiers": ["Command", "Shift"]
      },
      {
        "action": "assert_selection",
        "expected": "Line 3\nLine 4\nLine 5"
      }
    ]
  },
  "Escape键功能测试": {
    "steps": [
      {
        "action": "comment",
        "text": "场景 1: 单光标模式下，选中文本后按 Escape 键"
      },
      {
        "action": "set_content",
        "text": "Hello World"
      },
      {
        "action": "move_cursor",
        "position": "1.0"
      },
      {
        "action": "select_text",
        "start": "1.0",
        "end": "1.5"
      },
      {
        "action": "assert_selection",
        "expected": "Hello"
      },
      {
        "action": "on_key_press",
        "keysym": "Escape",
        "modifiers": []
      },
      {
        "action": "assert_selection",
        "expected": ""
      },
      {
        "action": "assert_cursor_position",
        "expected": "1.5"
      },
      {
        "action": "comment",
        "text": "场景 2: 多光标模式下，选中文本后按 Escape 键"
      },
      {
        "action": "set_content",
        "text": "test test test"
      },
      {
        "action": "select_text",
        "start": "1.0",
        "end": "1.4"
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 3
      },
      {
        "action": "on_key_press",
        "keysym": "Escape",
        "modifiers": []
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 0
      },
      {
        "action": "assert_selection",
        "expected": ""
      }
    ]
  },
  "多光标编辑混合操作测试": {
    "steps": [
      {
        "action": "comment",
        "text": "场景 1: 先输入字符再粘贴之后再输入字符"
      },
      {
        "action": "set_content",
        "text": "test test test"
      },
      {
        "action": "select_text",
        "start": "1.0",
        "end": "1.4"
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "on_key_press",
        "keysym": "d",
        "char": "d",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 3
      },
      {
        "action": "comment",
        "text": "输入字符 'X'"
      },
      {
        "action": "on_key_press",
        "keysym": "X",
        "char": "X",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "X X X"
      },
      {
        "action": "set_clipboard",
        "content": "PASTE"
      },
      {
        "action": "comment",
        "text": "粘贴内容"
      },
      {
        "action": "on_paste",
        "keysym": "v",
        "modifiers": ["Command"],
        "content": "PASTE"
      },
      {
        "action": "assert_content",
        "expected": "PASTE PASTE PASTE"
      },
      {
        "action": "comment",
        "text": "输入字符 'Y'"
      },
      {
        "action": "on_key_press",
        "keysym": "Y",
        "char": "Y",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Y Y Y"
      },
      {
        "action": "clear_multi_cursor_state"
      },
      {
        "action": "assert_multi_cursor_selections",
        "expected_count": 0
      }
    ]
  },
  "撤销重做功能测试": {
    "steps": [
      {
        "action": "comment",
        "text": "测试撤销/重做功能"
      },
      {
        "action": "set_content",
        "text": "Initial content"
      },
      {
        "action": "comment",
        "text": "输入文本"
      },
      {
        "action": "on_key_press",
        "keysym": "a",
        "char": "a",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Initial contenta"
      },
      {
        "action": "comment",
        "text": "撤销操作"
      },
      {
        "action": "on_key_press",
        "keysym": "z",
        "char": "z",
        "modifiers": ["Command"]
      },
      {
        "action": "assert_content",
        "expected": "Initial content"
      },
      {
        "action": "comment",
        "text": "重做操作"
      },
      {
        "action": "on_key_press",
        "keysym": "Z",
        "char": "Z",
        "modifiers": ["Command", "Shift"]
      },
      {
        "action": "assert_content",
        "expected": "Initial contenta"
      }
    ]
  },
  "字符计数功能测试": {
    "steps": [
      {
        "action": "comment",
        "text": "测试字符计数功能"
      },
      {
        "action": "set_content",
        "text": "Hello World"
      },
      {
        "action": "assert_char_count",
        "expected": 11
      },
      {
        "action": "comment",
        "text": "修改文本后测试字符计数"
      },
      {
        "action": "on_key_press",
        "keysym": "a",
        "char": "a",
        "modifiers": []
      },
      {
        "action": "assert_char_count",
        "expected": 12
      }
    ]
  },
  "缩进调整测试": {
    "steps": [
      {
        "action": "comment",
        "text": "测试单行缩进功能"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3"
      },
      {
        "action": "move_cursor",
        "position": "2.0"
      },
      {
        "action": "comment",
        "text": "测试 Tab 缩进"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\tLine 2\nLine 3"
      },
      {
        "action": "assert_cursor_position",
        "expected": "2.1"
      },
      {
        "action": "comment",
        "text": "测试 Shift+Tab 取消缩进"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": ["Shift"]
      },
      {
        "action": "assert_content",
        "expected": "Line 1\nLine 2\nLine 3"
      },
      {
        "action": "assert_cursor_position",
        "expected": "2.0"
      },
      {
        "action": "comment",
        "text": "测试多行缩进功能"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3\nLine 4"
      },
      {
        "action": "select_text",
        "start": "2.0",
        "end": "4.0"
      },
      {
        "action": "comment",
        "text": "测试 Tab 缩进多行"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\tLine 2\n\tLine 3\nLine 4"
      },
      {
        "action": "assert_selection",
        "expected": "\tLine 2\n\tLine 3"
      },
      {
        "action": "comment",
        "text": "测试 Shift+Tab 取消缩进多行"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": ["Shift"]
      },
      {
        "action": "assert_content",
        "expected": "Line 1\nLine 2\nLine 3\nLine 4"
      },
      {
        "action": "assert_selection",
        "expected": "Line 2\nLine 3"
      },
      {
        "action": "comment",
        "text": "测试场景：多行缩进后部分取消缩进"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3\nLine 4"
      },
      {
        "action": "select_text",
        "start": "2.0",
        "end": "4.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\tLine 2\n\tLine 3\nLine 4"
      },
      {
        "action": "move_cursor",
        "position": "2.0"
      },
      {
        "action": "clear_selection"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": ["Shift"]
      },
      {
        "action": "assert_content",
        "expected": "Line 1\nLine 2\n\tLine 3\nLine 4"
      },
      {
        "action": "assert_cursor_position",
        "expected": "2.0"
      },
      {
        "action": "comment",
        "text": "测试场景：多行缩进后取消部分缩进（保持选择）"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3\nLine 4"
      },
      {
        "action": "select_text",
        "start": "2.0",
        "end": "4.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\tLine 2\n\tLine 3\nLine 4"
      },
      {
        "action": "select_text",
        "start": "2.0",
        "end": "3.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": ["Shift"]
      },
      {
        "action": "assert_content",
        "expected": "Line 1\nLine 2\n\tLine 3\nLine 4"
      },
      {
        "action": "assert_selection",
        "expected": "Line 2"
      },
      {
        "action": "comment",
        "text": "测试场景：光标在行中间时的缩进"
      },
      {
        "action": "set_content",
        "text": "Line 1\nLine 2\nLine 3"
      },
      {
        "action": "move_cursor",
        "position": "2.4"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\tLine 2\nLine 3"
      },
      {
        "action": "assert_cursor_position",
        "expected": "2.5"
      },
      {
        "action": "comment",
        "text": "测试场景：空行的缩进"
      },
      {
        "action": "set_content",
        "text": "Line 1\n\nLine 3"
      },
      {
        "action": "move_cursor",
        "position": "2.0"
      },
      {
        "action": "on_key_press",
        "keysym": "Tab",
        "modifiers": []
      },
      {
        "action": "assert_content",
        "expected": "Line 1\n\t\nLine 3"
      },
      {
        "action": "assert_cursor_position",
        "expected": "2.1"
      }
    ]
  }
}
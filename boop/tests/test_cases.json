      ]
    },
    {
      "category": "Code Alignment",
      "scripts": [
        {
          "name": "Align Code",
          "tests": [
            {
              "input": "-h",
              "expected": "\nAlign Code - 代码对齐\n\n用法：在第一行指定对齐配置（可选）\n  格式：symbol:spaceMode:alignAll\n\n参数说明：\n  symbol    - 对齐符号（默认=）\n  spaceMode - 空格模式（默认both）\n              both   - 符号前后都加空格\n              after  - 仅符号后加空格\n              none   - 不添加空格\n  alignAll  - 是否对齐所有符号（true/false，默认true）\n\n示例：\n  =:both:true\n  name=John\n  age=30\n  city=NewYork\n  \n  将输出（符号前后加空格）：\n  name  = John\n  age   = 30\n  city  = NewYork\n\n  ::after:true\n  name:John\n  age:30\n  city:NewYork\n  \n  将输出（仅符号后加空格）：\n  name: John\n  age: 30\n  city: NewYork\n\n  |:both:true\n  name|John|age|30\n  city|NewYork|country|USA\n  \n  将输出（对齐所有符号）：\n  name | John   | age | 30\n  city | NewYork| country | USA\n\n  =:both:false\n  name=John=age=30\n  city=NewYork=country=USA\n  \n  将输出（仅对齐第一个符号）：\n  name  = John=age=30\n  city  = NewYork=country=USA\n\n  name=John\n  age=30\n  \n  将输出（默认配置）：\n  name  = John\n  age   = 30\n\n"
            },
            {
              "input": "name = John\nage = 30",
              "expected": "name = John\nage  = 30"
            },
            {
              "input": "::after\nname = John\nage = 30",
              "expected": "name = John\nage  = 30"
            },
            {
              "input": "::none\nname=John\nage=30",
              "expected": "name=John\nage=30"
            },
            {
              "input": "=>:both\nname => John\nage => 30",
              "expected": "name => John\nage  => 30"
            },
            {
              "input": "=:both:false\nname = John\nage = 30\ncity = NY",
              "expected": "name = John\nage  = 30\ncity = NY"
            }
          ]
        }
      ]
    },
    {
      "category": "Data Format Conversion",
      "scripts": [
        {
          "name": "Convert Data List Format",
          "tests": [
            {
              "input": "[{\"name\":\"John\"}]",
              "expected": "[\n  {\n    \"name\": \"John\"\n  }\n]"
            },
            {
              "input": "json\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n  {\n    \"name\": \"John\",\n    \"age\": 30\n  }\n]"
            },
            {
              "input": "csv\n[{\"name\":\"John\",\"age\":30},{\"name\":\"Jane\",\"age\":25}]",
              "expected": "name,age\nJohn,30\nJane,25"
            },
            {
              "input": "xml\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "<data>\n  <item>\n    <name>John</name>\n    <age>30</age>\n  </item>\n</data>"
            },
            {
              "input": "<data>\n  <item>\n    <name>John</name>\n    <age>30</age>\n  </item>\n</data>",
              "expected": "[\n  {\n    \"name\": \"John\",\n    \"age\": 30\n  }\n]"
            },
            {
              "input": "yaml\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "-\n  name: John\n  age: 30"
            },
            {
              "input": "-\n  name: John\n  age: 30",
              "expected": "[\n  {\n    \"name\": \"John\",\n    \"age\": 30\n  }\n]"
            },
            {
              "input": "tabtext\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "name\tage\nJohn\t30"
            },
            {
              "input": "name\tage\nJohn\t30",
              "expected": "[\n  {\n    \"name\": \"John\",\n    \"age\": 30\n  }\n]"
            },
            {
              "input": "sql:users:true\n[{\"name\":\"John\"},{\"name\":\"Jane\"}]",
              "expected": "INSERT INTO users (name) VALUES ('John');\nINSERT INTO users (name) VALUES ('Jane');"
            },
            {
              "input": "sql:products:false\n[{\"name\":\"Apple\"},{\"name\":\"Banana\"}]",
              "expected": "INSERT INTO products (name) VALUES\n  ('Apple'),\n  ('Banana');"
            },
            {
              "input": "INSERT INTO users (name, age) VALUES ('John', 30), ('Jane', 25);",
              "expected": "[\n  {\n    \"table\": \"users\",\n    \"name\": \"John\",\n    \"age\": 30\n  },\n  {\n    \"table\": \"users\",\n    \"name\": \"Jane\",\n    \"age\": 25\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "category": "Insert Numbers",
      "scripts": [
        {
          "name": "Insert Sequence Number",
          "tests": [
            {
              "input": "first line\nsecond line",
              "expected": "1 first line\n2 second line"
            },
            {
              "input": "1:1:n: \nfirst line\nsecond line",
              "expected": "1 first line\n2 second line"
            },
            {
              "input": "1:1:c:、\nfirst line\nsecond line",
              "expected": "一、first line\n二、second line"
            },
            {
              "input": "A:1:a:、\nfirst line\nsecond line",
              "expected": "A、first line\nB、second line"
            },
            {
              "input": "a:1:b:、\nfirst line\nsecond line",
              "expected": "a、first line\nb、second line"
            },
            {
              "input": "1:1:n:. \nfirst line\nsecond line",
              "expected": "1. first line\n2. second line"
            },
            {
              "input": "10:2:n: \nfirst line\nsecond line",
              "expected": "10 first line\n12 second line"
            },
            {
              "input": "1:1:n: :02\nfirst line\nsecond line\nthird line",
              "expected": "01 first line\n02 second line\n03 third line"
            },
            {
              "input": "1:1:n: :03\nfirst line\nsecond line",
              "expected": "001 first line\n002 second line"
            }
          ]
        }
      ]
    },
    {
      "category": "JSON Type Conversion",
      "scripts": [
        {
          "name": "Convert Json Code",
          "tests": [
            {
              "input": "[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n    {\n        name: \"John\",\n        age: 30\n    }\n]"
            },
            {
              "input": "js\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n    {\n        name: \"John\",\n        age: 30\n    }\n]"
            },
            {
              "input": "json\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n    {\n        \"name\": \"John\",\n        \"age\": 30\n    }\n]"
            },
            {
              "input": "py\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n    {\n        'name': 'John',\n        'age': 30\n    }\n]"
            },
            {
              "input": "lua\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "{\n    {\n        name = \"John\",\n        age = 30\n    }\n}"
            },
            {
              "input": "php\n[{\"name\":\"John\",\"age\":30}]",
              "expected": "[\n    [\n        'name' => 'John',\n        'age' => 30\n    ]\n];"
            },
            {
              "input": "js:php\n[{name:\"John\",age:30}]",
              "expected": "[\n    [\n        'name' => 'John',\n        'age' => 30\n    ]\n];"
            },
            {
              "input": "js:json\n[{name:\"John\",age:30}]",
              "expected": "[\n    {\n        \"name\": \"John\",\n        \"age\": 30\n    }\n]"
            }
          ]
        }
      ]
    },
    {
      "category": "Advanced Line Processing",
      "scripts": [
        {
          "name": "Lines Sort",
          "tests": [
            {
              "input": "zebra\napple",
              "expected": "apple\nzebra"
            },
            {
              "input": "asc\nzebra\napple",
              "expected": "apple\nzebra"
            },
            {
              "input": "desc\nzebra\napple",
              "expected": "zebra\napple"
            },
            {
              "input": "reverse\nfirst line\nsecond line",
              "expected": "second line\nfirst line"
            },
            {
              "input": "3,orange\n1,apple\n2,banana",
              "expected": "1,apple\n2,banana\n3,orange"
            },
            {
              "input": "1:desc:string\n3,orange\n1,apple\n2,banana",
              "expected": "3,orange\n2,banana\n1,apple"
            },
            {
              "input": "0:asc:string\n3,orange\n1,apple\n2,banana",
              "expected": "1,apple\n2,banana\n3,orange"
            },
            {
              "input": "1:desc:string:|\n3|orange\n1|apple\n2|banana",
              "expected": "3|orange\n2|banana\n1|apple"
            }
          ]
        },
        {
          "name": "Convert Number Base",
          "tests": [
            {
              "input": "255",
              "expected": "FF"
            },
            {
              "input": "2:10\n11111111",
              "expected": "255"
            },
            {
              "input": "10:16:false\n255",
              "expected": "ff"
            },
            {
              "input": "16:2:true\nFF",
              "expected": "11111111"
            }
          ]
        }
      ]
    },
    {
      "category": "Quick Replace",
      "scripts": [
        {
          "name": "Quick Replace",
          "tests": [
            {
              "input": "-h",
              "expected": "\nQuick Replace - 快速替换\n\n用法：在第一行指定替换规则（必需）\n  格式：source:target\n\n参数说明：\n  source - 要查找的字符串\n  target - 要替换成的字符串\n\n示例：\n  hello:hi\n  hello world\n  hello everyone\n  \n  将输出：\n  hi world\n  hi everyone\n\n  apple:orange\n  I like apple\n  apple pie is good\n  \n  将输出：\n  I like orange\n  orange pie is good\n\n  :empty\n  remove this text\n  remove that text\n  \n  将输出（删除指定文本）：\n  empty text\n  empty that text\n\n"
            },
            {
              "input": "old:new\nold text\nanother old text",
              "expected": "new text\nanother new text"
            }
          ]
        }
      ]
    },
    {
      "category": "Data Format Conversion",
      "scripts": [
        {
          "name": "Convert Data Key Value Format",
          "tests": [
            {
              "input": "{\"name\":\"John\"}",
              "expected": "{\n  \"name\": \"John\"\n}"
            },
            {
              "input": "json\n{\"name\":\"John\"}",
              "expected": "{\n  \"name\": \"John\"\n}"
            },
            {
              "input": "url\n{\"name\":\"John\"}",
              "expected": "name=John"
            },
            {
              "input": "?name=John",
              "expected": "{\n  \"url_path\": \"http://example.com/\",\n  \"name\": \"John\"\n}"
            },

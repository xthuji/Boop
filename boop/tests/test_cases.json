{
  "testCases": [
    {
      "category": "Encoding/Decoding",
      "scripts": [
        {
          "name": "Toggle Url",
          "tests": [
            {
              "input": "encode\nhello world",
              "expected": "hello%20world"
            },
            {
              "input": "decode\nhello%20world",
              "expected": "hello world"
            }
          ]
        },
        {
          "name": "Toggle Base64",
          "tests": [
            {
              "input": "encode\nhello world",
              "expected": "aGVsbG8gd29ybGQ="
            },
            {
              "input": "decode\naGVsbG8gd29ybGQ=",
              "expected": "hello world"
            }
          ]
        },
        {
          "name": "Toggle Html",
          "tests": [
            {
              "input": "encode\n<div>Hello</div>",
              "expected": "&lt;div&gt;Hello&lt;/div&gt;"
            },
            {
              "input": "decode\n&lt;div&gt;Hello&lt;/div&gt;",
              "expected": "<div>Hello</div>"
            }
          ]
        },
        {
          "name": "Toggle Hex",
          "tests": [
            {
              "input": "encode\nhello",
              "expected": "68656c6c6f"
            },
            {
              "input": "decode\n68656c6c6f",
              "expected": "hello"
            }
          ]
        },
        {
          "name": "Toggle Unicode",
          "tests": [
            {
              "input": "encode\nhello",
              "expected": "\\u0068\\u0065\\u006c\\u006c\\u006f"
            },
            {
              "input": "decode\n\\u0068\\u0065\\u006c\\u006c\\u006f",
              "expected": "hello"
            }
          ]
        },
        {
          "name": "Toggle Ascii",
          "tests": [
            {
              "input": "encode\nhello",
              "expected": "104 101 108 108 111"
            },
            {
              "input": "decode\n104 101 108 108 111",
              "expected": "hello"
            }
          ]
        }
      ]
    },

    {
      "category": "Quotes Handling",
      "scripts": [
        {
          "name": "Quotes Toggle",
          "tests": [
            {
              "input": "\"\nHe said \"Hello\"",
              "expected": "\"He said \\\"Hello\\\"\""
            },
            {
              "input": "'\nIt's a test",
              "expected": "'It\\'s a test'"
            },
            {
              "input": "\"\nIt's a test",
              "expected": "\"It's a test\""
            },
            {
              "input": "'\nHe said \"Hello\"",
              "expected": "'He said \"Hello\"'"
            },
            {
              "input": "\"\nhello world",
              "expected": "\"hello world\""
            },
            {
              "input": "'\nhello world",
              "expected": "'hello world'"
            },
            {
              "input": "\\'\nIt's a test",
              "expected": "It\\'s a test"
            },
            {
              "input": "\\\"\nHe said \"Hello\"",
              "expected": "He said \\\"Hello\\\""
            },
            {
              "input": "toggle\n\"hello\"",
              "expected": "'hello'"
            },
            {
              "input": "t\n'hello'",
              "expected": "\"hello\""
            },
            {
              "input": "toggle\n\"hello\" 'world'",
              "expected": "'hello' \"world\""
            },
            {
              "input": "hello world",
              "expected": "\"hello world\""
            }
          ]
        }
      ]
    },
    {
      "category": "Space/Tab Conversion",
      "scripts": [
        {
          "name": "Space To Tab",
          "tests": [
            {
              "input": "hello world",
              "expected": "hello\tworld"
            },
            {
              "input": "1\nhello world",
              "expected": "hello\tworld"
            },
            {
              "input": "2\nhello  world",
              "expected": "hello\tworld"
            },
            {
              "input": "4\n    hello",
              "expected": "\thello"
            }
          ]
        },
        {
          "name": "Tab To Space",
          "tests": [
            {
              "input": "hello\tworld",
              "expected": "hello  world"
            },
            {
              "input": "1\nhello\tworld",
              "expected": "hello world"
            },
            {
              "input": "2\nhello\tworld",
              "expected": "hello  world"
            },
            {
              "input": "4\n\thello",
              "expected": "    hello"
            }
          ]
        }
      ]
    },
